{
  "name": "directus-extension-panel-collection-metrics",
  "version": "1.0.0",
  "description": "A Directus panel extension to display collection metrics",
  "keywords": [
    "directus",
    "directus-extension",
    "directus-custom-extension",
    "directus-extension-panel"
  ],
  "type": "module",
  "directus:extension": {
    "type": "panel",
    "path": "dist/index.js",
    "source": "src/index.js",
    "host": "^11.0.0"
  },
  "scripts": {
    "build": "directus-extension build",
    "dev": "directus-extension build -w --no-minify",
    "link": "directus-extension link"
  },
  "devDependencies": {
    "@directus/extensions-sdk": "^11.0.0",
    "vue": "^3.3.0"
  },
  "dependencies": {}
}
